{
  "name": "lattely",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "docker compose up -d --wait && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:neon-development": "DATABASE_URL=\"$(neon connection-string development --project-id silent-forest-50770475)\" drizzle-kit migrate",
    "db:migrate:neon-production": "DATABASE_URL=\"$(neon connection-string production --project-id silent-forest-50770475)\" drizzle-kit migrate",
    "db:seed": "node --env-file=.env.development scripts/seed.ts",
    "test:e2e": "docker compose up -d --wait && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@neon/auth": "^0.8.2",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "nuqs": "2.10.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.5.1",
  "type": "module"
}
